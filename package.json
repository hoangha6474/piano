    "@tonejs/midi": "^2.0.28",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "opensheetmusicdisplay": "^1.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
